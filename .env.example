# GEMINI_API_KEY is no longer used by the app and is no longer read at runtime.
#
# Advisor calls now route through Firebase AI Logic (see ai/GeminiClient.kt), which holds the
# credential server-side and is gated by App Check. Any API key compiled into an APK is
# extractable from the binary, so a client-side key is effectively public and billable by anyone.
#
# Do NOT reintroduce a GEMINI_API_KEY here or in BuildConfig. This file is retained only because
# the Secrets Gradle plugin is configured with it as the default properties file.
GEMINI_API_KEY=UNUSED_ROUTED_VIA_FIREBASE_AI_LOGIC
